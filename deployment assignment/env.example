# Copy to .env.development / .env.staging / .env.production and fill values

NODE_ENV=development
PORT=3000
APP_VERSION=0.0.0

# Use a DIFFERENT MongoDB Atlas cluster (or at minimum a different project/cluster/db user) per environment
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB=transaction_dev
MONGODB_CONNECT_ON_STARTUP=true

# Optional override; defaults: dev=debug, staging=info, production=error
LOG_LEVEL=

# JSON object, e.g. {"newFeature": true}
FEATURE_FLAGS={}
