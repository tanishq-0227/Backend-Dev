NODE_ENV=production
PORT=3000
APP_VERSION=0.1.0

# Production cluster MUST be isolated from dev/staging
MONGODB_URI=mongodb+srv://prod_user:prod_password@prod-cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=transaction_prod
MONGODB_CONNECT_ON_STARTUP=true

LOG_LEVEL=error
FEATURE_FLAGS={}
